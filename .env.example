# ATLAS OS & ATLAS Vision Configuration

# ============================================================
# REMOTE ATLAS VISION INTEGRATION (10.9.96.13:8765)
# ============================================================
# Base URL of the remote ATLAS Vision machine.
# Set ATLAS_VISION_ENABLED=false to disable remote integration entirely.
ATLAS_VISION_BASE_URL=http://10.9.96.13:8765
ATLAS_VISION_TIMEOUT=10
ATLAS_VISION_ENABLED=true

# Optional shared integration token (leave blank until Vision machine is ready).
# ATLAS OS will send this as a Bearer token on every Vision API call.
# Never expose this to the browser — only used server-to-server.
ATLAS_VISION_INTEGRATION_TOKEN=

# ============================================================
# LOCAL VISION EDGE (LEGACY - port 8002)
# These settings control the OLD local Vision Edge node.
# They are preserved for backward compatibility but are NOT
# used for the new remote ATLAS Vision integration.
# ============================================================

# Camera Enable State
ATLAS_CAMERA_ENABLED=true

# Camera Source Identifier
# Local webcam: 0, 1, etc.
# Network camera / DroidCam IP camera: http://192.168.1.100:4747/video
ATLAS_CAMERA_SOURCE=0

# Camera Capture Parameters
ATLAS_CAMERA_FPS=20
ATLAS_CAMERA_WIDTH=1280
ATLAS_CAMERA_HEIGHT=720

# Pipeline Processing Performance Throttling
ATLAS_DETECTION_FPS=10
ATLAS_RECOGNITION_COOLDOWN_SECONDS=3
ATLAS_MAX_RECOGNITION_QUEUE=20
